<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Vortex" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorOnPrimary">#FF04150F</item>
        <item name="colorPrimaryContainer">@color/accent_dark</item>
        <item name="colorOnPrimaryContainer">#FF04150F</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorOnSecondary">@color/text_primary</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/surface_alt</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/stroke</item>
        <item name="colorOutlineVariant">@color/stroke</item>
        <item name="colorError">@color/danger</item>
        <item name="colorOnError">@color/text_primary</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_tertiary</item>
        <item name="materialAlertDialogTheme">@style/Theme.Vortex.Dialog</item>
        <item name="bottomSheetDialogTheme">@style/Theme.Vortex.BottomSheet</item>
    </style>

    <style name="Theme.Vortex.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">@color/surface_alt</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="colorPrimary">@color/accent</item>
        <item name="colorOnPrimary">#FF04150F</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.Vortex.DialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.Vortex.DialogButton</item>
    </style>

    <style name="Theme.Vortex.BottomSheet" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.Vortex.BottomSheet</item>
    </style>

    <style name="Widget.Vortex.BottomSheet" parent="Widget.Material3.BottomSheet.Modal">
        <item name="backgroundTint">@color/surface_alt</item>
    </style>

    <style name="Widget.Vortex.DialogButton" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">@color/accent</item>
        <item name="android:textAllCaps">false</item>
    </style>
</resources>
