<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/bg"
        app:title="@string/title_settings"
        app:titleTextColor="@color/text_primary" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="40dp">

                <TextView
                    style="@style/Widget.Vortex.SectionHeader"
                    android:text="@string/setting_section_connection" />
                <LinearLayout
                    android:id="@+id/btn_mode"
                    style="@style/Widget.Vortex.Row">
                    <TextView
                        style="@style/Widget.Vortex.RowTitle"
                        android:text="@string/setting_mode" />
                    <TextView
                        android:id="@+id/summary"
                        style="@style/Widget.Vortex.RowSummary"
                        android:layout_marginTop="2dp"
                        android:text="" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/btn_stack"
                    style="@style/Widget.Vortex.Row">
                    <TextView
                        style="@style/Widget.Vortex.RowTitle"
                        android:text="@string/setting_stack" />
                    <TextView
                        android:id="@+id/summary"
                        style="@style/Widget.Vortex.RowSummary"
                        android:layout_marginTop="2dp"
                        android:text="" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/btn_mtu"
                    style="@style/Widget.Vortex.Row">
                    <TextView
                        style="@style/Widget.Vortex.RowTitle"
                        android:text="@string/setting_mtu" />
                    <TextView
                        android:id="@+id/summary"
                        style="@style/Widget.Vortex.RowSummary"
                        android:layout_marginTop="2dp"
                        android:text="" />
                </LinearLayout>
                <LinearLayout
                    style="@style/Widget.Vortex.Row"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Widget.Vortex.RowTitle"
                            android:text="@string/setting_row_ipv6" />

                        <TextView
                            style="@style/Widget.Vortex.RowSummary"
                            android:text="@string/setting_row_ipv6_desc" />
                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/sw_ipv6"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:checked="true" />
                </LinearLayout>
                <LinearLayout
                    style="@style/Widget.Vortex.Row"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Widget.Vortex.RowTitle"
                            android:text="@string/setting_row_bypass" />

                        <TextView
                            style="@style/Widget.Vortex.RowSummary"
                            android:text="@string/setting_row_bypass_desc" />
                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/sw_bypass"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:checked="false" />
                </LinearLayout>
                <LinearLayout
                    style="@style/Widget.Vortex.Row"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Widget.Vortex.RowTitle"
                            android:text="@string/setting_row_strict" />

                        <TextView
                            style="@style/Widget.Vortex.RowSummary"
                            android:text="@string/setting_row_strict_desc" />
                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/sw_strict"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:checked="false" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/btn_per_app"
                    style="@style/Widget.Vortex.Row">
                    <TextView
                        style="@style/Widget.Vortex.RowTitle"
                        android:text="@string/setting_row_per_app" />
                    <TextView
                        style="@style/Widget.Vortex.RowSummary"
                        android:text="@string/setting_row_per_app_desc" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/btn_apps_proxy"
                    style="@style/Widget.Vortex.Row">
                    <TextView
                        style="@style/Widget.Vortex.RowTitle"
                        android:text="@string/mode_bypass" />
                </LinearLayout>
                <TextView
                    style="@style/Widget.Vortex.SectionHeader"
                    android:text="@string/setting_section_dns" />
                <LinearLayout
                    android:id="@+id/btn_dns_direct"
                    style="@style/Widget.Vortex.Row">
                    <TextView
                        style="@style/Widget.Vortex.RowTitle"
                        android:text="@string/setting_dns_direct" />
                    <TextView
                        android:id="@+id/summary"
                        style="@style/Widget.Vortex.RowSummary"
                        android:layout_marginTop="2dp"
                        android:text="" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/btn_dns_remote"
                    style="@style/Widget.Vortex.Row">
                    <TextView
                        style="@style/Widget.Vortex.RowTitle"
                        android:text="@string/setting_dns_remote" />
                    <TextView
                        android:id="@+id/summary"
                        style="@style/Widget.Vortex.RowSummary"
                        android:layout_marginTop="2dp"
                        android:text="" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/btn_dns_sni"
                    style="@style/Widget.Vortex.Row">
                    <TextView
                        style="@style/Widget.Vortex.RowTitle"
                        android:text="@string/setting_dns_sni" />
                    <TextView
                        android:id="@+id/summary"
                        style="@style/Widget.Vortex.RowSummary"
                        android:layout_marginTop="2dp"
                        android:text="" />
                </LinearLayout>
                <LinearLayout
                    style="@style/Widget.Vortex.Row"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Widget.Vortex.RowTitle"
                            android:text="@string/setting_row_doh" />

                        <TextView
                            style="@style/Widget.Vortex.RowSummary"
                            android:text="@string/setting_dns_remote" />
                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/sw_doh"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:checked="true" />
                </LinearLayout>
                <LinearLayout
                    style="@style/Widget.Vortex.Row"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Widget.Vortex.RowTitle"
                            android:text="@string/setting_row_dns_cache" />

                        <TextView
                            style="@style/Widget.Vortex.RowSummary"
                            android:text="@string/setting_row_doh" />
                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/sw_dns_cache"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:checked="false" />
                </LinearLayout>
                <LinearLayout
                    style="@style/Widget.Vortex.Row"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Widget.Vortex.RowTitle"
                            android:text="@string/setting_row_fakeip" />

                        <TextView
                            style="@style/Widget.Vortex.RowSummary"
                            android:text="@string/setting_row_fakeip_desc" />
                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/sw_fakeip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:checked="false" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/btn_direct_domains"
                    style="@style/Widget.Vortex.Row">
                    <TextView
                        style="@style/Widget.Vortex.RowTitle"
                        android:text="@string/setting_direct_domains" />
                    <TextView
                        android:id="@+id/summary"
                        style="@style/Widget.Vortex.RowSummary"
                        android:layout_marginTop="2dp"
                        android:text="" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/btn_block_domains"
                    style="@style/Widget.Vortex.Row">
                    <TextView
                        style="@style/Widget.Vortex.RowTitle"
                        android:text="@string/setting_block_domains" />
                    <TextView
                        android:id="@+id/summary"
                        style="@style/Widget.Vortex.RowSummary"
                        android:layout_marginTop="2dp"
                        android:text="" />
                </LinearLayout>
                <TextView
                    style="@style/Widget.Vortex.SectionHeader"
                    android:text="@string/setting_section_engine" />
                <LinearLayout
                    style="@style/Widget.Vortex.Row"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Widget.Vortex.RowTitle"
                            android:text="@string/setting_row_sniff" />

                        <TextView
                            style="@style/Widget.Vortex.RowSummary"
                            android:text="@string/setting_row_sniff_desc" />
                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/sw_sniff"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:checked="true" />
                </LinearLayout>
                <LinearLayout
                    style="@style/Widget.Vortex.Row"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Widget.Vortex.RowTitle"
                            android:text="@string/setting_row_mux" />

                        <TextView
                            style="@style/Widget.Vortex.RowSummary"
                            android:text="@string/setting_row_mux_desc" />
                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/sw_mux"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:checked="false" />
                </LinearLayout>
                <LinearLayout
                    style="@style/Widget.Vortex.Row"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Widget.Vortex.RowTitle"
                            android:text="@string/setting_row_fragment" />

                        <TextView
                            style="@style/Widget.Vortex.RowSummary"
                            android:text="@string/setting_row_fragment_desc" />
                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/sw_fragment"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:checked="false" />
                </LinearLayout>
                <LinearLayout
                    style="@style/Widget.Vortex.Row"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Widget.Vortex.RowTitle"
                            android:text="@string/setting_row_record_fragment" />

                        <TextView
                            style="@style/Widget.Vortex.RowSummary"
                            android:text="@string/setting_row_fragment" />
                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/sw_record_fragment"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:checked="false" />
                </LinearLayout>
                <LinearLayout
                    style="@style/Widget.Vortex.Row"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Widget.Vortex.RowTitle"
                            android:text="@string/setting_row_auto_select" />

                        <TextView
                            style="@style/Widget.Vortex.RowSummary"
                            android:text="@string/setting_row_auto_select_desc" />
                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/sw_auto_select"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:checked="false" />
                </LinearLayout>
                <LinearLayout
                    style="@style/Widget.Vortex.Row"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Widget.Vortex.RowTitle"
                            android:text="@string/setting_row_auto_start" />

                        <TextView
                            style="@style/Widget.Vortex.RowSummary"
                            android:text="@string/setting_row_auto_select" />
                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/sw_auto_start"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:checked="false" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/btn_url_test"
                    style="@style/Widget.Vortex.Row">
                    <TextView
                        style="@style/Widget.Vortex.RowTitle"
                        android:text="@string/setting_url_test" />
                    <TextView
                        android:id="@+id/summary"
                        style="@style/Widget.Vortex.RowSummary"
                        android:layout_marginTop="2dp"
                        android:text="" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/btn_log_level"
                    style="@style/Widget.Vortex.Row">
                    <TextView
                        style="@style/Widget.Vortex.RowTitle"
                        android:text="@string/setting_row_log_level" />
                    <TextView
                        android:id="@+id/summary"
                        style="@style/Widget.Vortex.RowSummary"
                        android:layout_marginTop="2dp"
                        android:text="" />
                </LinearLayout>
                <TextView
                    style="@style/Widget.Vortex.SectionHeader"
                    android:text="@string/setting_section_subscriptions" />
                <LinearLayout
                    style="@style/Widget.Vortex.Row"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Widget.Vortex.RowTitle"
                            android:text="@string/setting_row_sub_auto" />

                        <TextView
                            style="@style/Widget.Vortex.RowSummary"
                            android:text="@string/setting_url_test" />
                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/sw_sub_auto"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:checked="true" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/btn_sub_interval"
                    style="@style/Widget.Vortex.Row">
                    <TextView
                        style="@style/Widget.Vortex.RowTitle"
                        android:text="@string/setting_sub_interval" />
                    <TextView
                        android:id="@+id/summary"
                        style="@style/Widget.Vortex.RowSummary"
                        android:layout_marginTop="2dp"
                        android:text="" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/btn_user_agent"
                    style="@style/Widget.Vortex.Row">
                    <TextView
                        style="@style/Widget.Vortex.RowTitle"
                        android:text="@string/setting_user_agent" />
                    <TextView
                        android:id="@+id/summary"
                        style="@style/Widget.Vortex.RowSummary"
                        android:layout_marginTop="2dp"
                        android:text="" />
                </LinearLayout>
                <TextView
                    style="@style/Widget.Vortex.SectionHeader"
                    android:text="@string/setting_section_tools" />
                <LinearLayout
                    android:id="@+id/btn_logs"
                    style="@style/Widget.Vortex.Row">
                    <TextView
                        style="@style/Widget.Vortex.RowTitle"
                        android:text="@string/setting_row_logs" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/btn_connections"
                    style="@style/Widget.Vortex.Row">
                    <TextView
                        style="@style/Widget.Vortex.RowTitle"
                        android:text="@string/setting_row_connections" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/btn_about"
                    style="@style/Widget.Vortex.Row">
                    <TextView
                        style="@style/Widget.Vortex.RowTitle"
                        android:text="@string/setting_row_about" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/btn_reset"
                    style="@style/Widget.Vortex.Row">
                    <TextView
                        style="@style/Widget.Vortex.RowTitle"
                        android:text="@string/setting_row_reset" />
                </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
